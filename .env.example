WOVN_SECRET_KEY=change-me-in-production
WOVN_DATA_DIR=./data
WOVN_CORS_ORIGINS=http://localhost:3000
WOVN_DATABASE_URL=sqlite:///data/wovn.db
WOVN_WEB_ORIGIN=http://localhost:3000
WOVN_GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
WOVN_GITHUB_CLIENT_ID=
WOVN_GITHUB_CLIENT_SECRET=
# Rotating WOVN_SECRET_KEY invalidates encrypted Groq/OpenRouter keys and GitHub tokens (fernet-v1).
# Set WOVN_MULTI_AGENT=false to use the legacy summarize → synthesize path.
WOVN_MULTI_AGENT=true
